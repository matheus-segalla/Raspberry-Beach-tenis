# ==============================================================================
# FOX REPLAY — MODELO DE CONFIGURAÇÃO DO TOTEM (EXEMPLO)
# Copie este arquivo para .env e preencha com as credenciais da sua arena
# NUNCA envie senhas reais ou tokens para o GitHub!
# ==============================================================================

# Buffer de Vídeo
TEMPO_SEGMENTO=5
QUANTIDADE_SEGMENTOS=14
SEGUNDOS_REPLAY=30
TRAVA_TEMPO_SEGUNDOS=20
PASTA_SEGMENTOS=/tmp/segmentos
PASTA_REPLAYS=./replays

# Câmera IP Hikvision (ou nome da webcam USB)
# Formato: rtsp://USUARIO:SENHA@IP_DA_CAMERA:554/Streaming/Channels/101
CAMERA_NOME=rtsp://admin:SuaSenhaAqui@192.168.1.64:554/Streaming/Channels/101

# Resolução e Taxa de Quadros
RESOLUCAO=1280x720
FPS=30

# Pino GPIO do Botão na Grade
PINO_BOTAO_GPIO=17

# Tempo de retenção local em horas
RETENCAO_LOCAL_HORAS=24

# Credenciais Supabase (URL e Chave Anônima Pública)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui

# Token Único do Totem (gerado no painel da arena em /dashboard)
TOKEN_DISPOSITIVO=fox_tok_exemplo_aqui

# URL da Plataforma Web
FRONTEND_URL=https://fox-replay.vercel.app
