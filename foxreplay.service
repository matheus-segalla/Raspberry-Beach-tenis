[Unit]
Description=Fox Replay Totem Core Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Raspberry-Beach-tenis
ExecStart=/usr/bin/python3 /home/pi/Raspberry-Beach-tenis/index.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
