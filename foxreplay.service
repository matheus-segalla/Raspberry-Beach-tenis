[Unit]
Description=Fox Replay Totem Core Service (Auto-Update via GitHub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Raspberry-Beach-tenis
ExecStart=/bin/bash /home/pi/Raspberry-Beach-tenis/iniciar_totem.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
